# Server Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/informed_voter?schema=public"

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# External APIs
PROPUBLICA_API_KEY=your-propublica-api-key
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key
LEGISCAN_API_KEY=your-legiscan-api-key

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (for verification)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@informedvoter.org

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
